<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Comanda" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores de marca Munchly -->
        <item name="colorPrimary">@color/munchly_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/munchly_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/munchly_background</item>
        <item name="colorSurface">@color/munchly_background</item>
        <item name="colorOnSurface">@color/munchly_text_primary</item>

        <!-- Configuración de barras del sistema -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.Comanda" parent="Base.Theme.Comanda" />
</resources>
