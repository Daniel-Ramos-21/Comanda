<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/menuRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/munchly_background">

    <!-- Contenido desplazable del Menú -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollMenu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_medium"
            android:paddingTop="@dimen/spacing_medium"
            android:paddingEnd="@dimen/spacing_medium"
            android:paddingBottom="@dimen/spacing_xlarge">

            <!-- Encabezado de Munchly con campana de notificaciones -->
            <RelativeLayout
                android:id="@+id/headerMenuLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/ivNotificaciones"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:id="@+id/ivMenuLogo"
                        android:layout_width="@dimen/logo_size_header"
                        android:layout_height="@dimen/logo_size_header"
                        android:contentDescription="@string/cd_munchly_logo"
                        android:src="@drawable/ic_munchly_logo" />

                    <TextView
                        android:id="@+id/tvMenuBrand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_small"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.03"
                        android:text="@string/munchly_brand_name"
                        android:textColor="@color/munchly_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivNotificaciones"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:contentDescription="@string/cd_notifications"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_bell" />
            </RelativeLayout>

            <!-- Saludo editorial -->
            <TextView
                android:id="@+id/tvGreetingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:fontFamily="sans-serif-black"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/greeting_title"
                android:textColor="@color/munchly_text_primary"
                android:textSize="@dimen/text_size_greeting"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGreetingSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:text="@string/greeting_subtitle"
                android:textColor="@color/munchly_text_secondary"
                android:textSize="@dimen/text_size_greeting_sub" />

            <!-- Barra de búsqueda con acceso directo a Filtros -->
            <LinearLayout
                android:id="@+id/searchBarContainer"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="@dimen/spacing_medium"
                android:background="@drawable/bg_search_bar"
                android:elevation="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_medium"
                android:paddingEnd="@dimen/spacing_small">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/search_placeholder"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/etBuscarMenu"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="sans-serif"
                    android:hint="@string/search_placeholder"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/munchly_text_primary"
                    android:textColorHint="@color/munchly_text_secondary"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btnAbrirFiltros"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:contentDescription="@string/cd_filter_button"
                    android:focusable="true"
                    android:padding="9dp"
                    android:src="@drawable/ic_filter" />
            </LinearLayout>

            <!-- Indicador de filtros activos (si los hay) -->
            <LinearLayout
                android:id="@+id/layoutIndicadorFiltroActivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvFiltroActivoTexto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/munchly_accent"
                    android:textSize="13sp"
                    tools:text="Filtros activos: Queso, $2 - $5" />

                <TextView
                    android:id="@+id/btnLimpiarFiltroRapido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:padding="4dp"
                    android:text="@string/btn_remove_filters"
                    android:textColor="@color/munchly_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Sección: Categorías -->
            <TextView
                android:id="@+id/tvTituloCategorias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:fontFamily="sans-serif-medium"
                android:text="@string/section_categories"
                android:textColor="@color/munchly_text_primary"
                android:textSize="@dimen/text_size_section"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategorias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Sección: Favoritos de la casa -->
            <TextView
                android:id="@+id/tvTituloFavoritos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:fontFamily="sans-serif-medium"
                android:text="@string/section_house_favorites"
                android:textColor="@color/munchly_text_primary"
                android:textSize="@dimen/text_size_section"
                android:textStyle="bold" />

            <!-- Tarjeta destacada de Pupusas de Queso y Loroco -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFavoritoCasa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/munchly_surface"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="2dp"
                app:strokeColor="@color/munchly_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/product_favorite_image_height">

                        <ImageView
                            android:id="@+id/ivFavoritoImagen"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/munchly_surface_warm"
                            android:contentDescription="@string/cd_munchly_hero"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_food_pupusas" />

                        <TextView
                            android:id="@+id/tvBadgeMasPedido"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="@dimen/spacing_small"
                            android:background="@drawable/bg_badge_more_ordered"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.02"
                            android:text="@string/badge_most_ordered"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_medium">

                        <TextView
                            android:id="@+id/tvFavoritoNombre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/munchly_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="Pupusas de Queso y Loroco" />

                        <TextView
                            android:id="@+id/tvFavoritoDescripcion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif"
                            android:lineSpacingMultiplier="1.15"
                            android:textColor="@color/munchly_text_secondary"
                            android:textSize="13sp"
                            tools:text="Tradicionales pupusas hechas a mano con masa de maíz artesanal, queso fundido y flor de loroco fresca. Acompañadas de curtido y salsa." />

                        <TextView
                            android:id="@+id/tvFavoritoPrecio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/munchly_accent"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="$3.50" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sección: También te puede gustar -->
            <TextView
                android:id="@+id/tvTituloRecomendados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:fontFamily="sans-serif-medium"
                android:text="@string/section_recommended"
                android:textColor="@color/munchly_text_primary"
                android:textSize="@dimen/text_size_section"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecomendados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Sección: Catálogo completo / Resultados filtrados -->
            <TextView
                android:id="@+id/tvTituloTodosProductos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:fontFamily="sans-serif-medium"
                android:text="@string/section_all_products"
                android:textColor="@color/munchly_text_primary"
                android:textSize="@dimen/text_size_section"
                android:textStyle="bold" />

            <!-- Estado de carga -->
            <ProgressBar
                android:id="@+id/pbCargandoMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/spacing_large"
                android:indeterminateTint="@color/munchly_primary"
                android:visibility="visible" />

            <!-- Estado vacío cuando no hay coincidencias -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/empty_products_title"
                    android:textColor="@color/munchly_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="@string/empty_products_subtitle"
                    android:textColor="@color/munchly_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTodosProductos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barra de navegación inferior fija -->
    <LinearLayout
        android:id="@+id/bottomNavigationContainer"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_nav_height"
        android:background="@drawable/bg_bottom_nav"
        android:baselineAligned="false"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Inicio (activo) -->
        <LinearLayout
            android:id="@+id/btnNavInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_home"
                android:src="@drawable/ic_nav_home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="13dp"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/nav_home"
                android:textColor="@color/munchly_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Buscar -->
        <LinearLayout
            android:id="@+id/btnNavBuscar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_search"
                android:src="@drawable/ic_nav_search" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="@string/nav_search"
                android:textColor="@color/munchly_nav_inactive"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Pedidos -->
        <LinearLayout
            android:id="@+id/btnNavPedidos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_orders"
                android:src="@drawable/ic_nav_orders" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="@string/nav_orders"
                android:textColor="@color/munchly_nav_inactive"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Perfil -->
        <LinearLayout
            android:id="@+id/btnNavPerfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/nav_profile"
                android:src="@drawable/ic_nav_profile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="@string/nav_profile"
                android:textColor="@color/munchly_nav_inactive"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
