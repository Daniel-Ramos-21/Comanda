<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chipContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/spacing_small"
    android:background="@drawable/bg_chip_unselected"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvChipNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/munchly_text_secondary"
        android:textSize="@dimen/text_size_chip"
        tools:text="Categoría" />
</FrameLayout>
