<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardProductoVertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_medium"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/munchly_surface"
    app:cardCornerRadius="@dimen/corner_radius_card"
    app:cardElevation="2dp"
    app:strokeColor="@color/munchly_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_small">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="92dp"
            android:layout_height="92dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivProductoVertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/munchly_surface_warm"
                android:contentDescription="@string/cd_munchly_hero"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_food_tacos" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreVertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/munchly_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Nombre del platillo" />

            <TextView
                android:id="@+id/tvDescripcionVertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="2"
                android:textColor="@color/munchly_text_secondary"
                android:textSize="13sp"
                tools:text="Descripción detallada de ingredientes y preparación." />

            <TextView
                android:id="@+id/tvPrecioVertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/munchly_accent"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="$0.00" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
